# Robinhood Chain mainnet = 4663, testnet = 46630 (testnet needs RPC_URL)
CHAIN_ID=4663
# Defaults to the public RPC (rate limited). A paid RPC is strongly recommended.
RPC_URL=

# Comma-separated private keys. USE FRESH BURNER WALLETS holding only gas ETH.
PRIVATE_KEYS=
# Simulates and logs only. Set to false to actually send mint txs.
DRY_RUN=true

POLL_INTERVAL_MS=2000
# Detection window, in blocks
WINDOW_BLOCKS=1200
# A collection is "hot" once this many distinct wallets free-minted in the window...
MIN_UNIQUE_MINTERS=15
# ...across at least this many txs
MIN_MINT_TXS=20
# Mint txs per wallet per collection
MAX_MINTS_PER_COLLECTION=1
# Worst-case gas spend allowed per mint tx (ETH)
MAX_GAS_COST_ETH=0.0005
# Optional ceiling on maxFeePerGas (gwei)
MAX_FEE_PER_GAS_GWEI=

# Comma-separated collection addresses to never mint / to exclusively mint
DENYLIST=
ALLOWLIST=
STATE_FILE=state.json
