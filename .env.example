# ── Network ────────────────────────────────────────────────────────────────
# Robinhood Chain mainnet = 4663, testnet = 46630. Any other id works with RPC_URLS (e.g. a local fork).
CHAIN_ID=4663
# One or more RPC URLs (comma/space separated). Extra URLs are automatic failover,
# ranked by latency. Paid, low-latency RPCs are what win races. Empty = public RPC.
RPC_URLS=
# Fast, reliable endpoint(s) for the actions that matter: simulating, estimating, sending, balances.
# Put a provider URL here (e.g. your Alchemy https URL). RPC_URLS stays as the backup. A metered free
# plan (Alchemy: 30M units/month) is fine for this because a mint costs a few hundred units, but it
# is NOT enough to also run the block watcher, which stays on RPC_URLS.
ACTION_RPC_URLS=
RPC_TIMEOUT_MS=5000
# Parallel requests while scanning blocks. The public RPC rate limits hard (keep ~8); a paid RPC can take 25+.
RPC_CONCURRENCY=8

# ── Wallets (all sources are merged and de-duplicated) ─────────────────────
# USE FRESH BURNER WALLETS holding only gas ETH.
# Easiest: `npm run wallets:new -- 25` then KEYS_FILE=wallets.txt
KEYS_FILE=
PRIVATE_KEYS=
# Or derive WALLET_COUNT wallets from one seed phrase (m/44'/60'/0'/0/i)
MNEMONIC=
WALLET_COUNT=20
# How many wallets mint at the same time
WALLET_CONCURRENCY=25

# ── Mode ───────────────────────────────────────────────────────────────────
# Simulates and logs only. Set to false to actually send mint txs.
DRY_RUN=true

# ── Detection ──────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=1000
# ~10 blocks per second on Robinhood Chain: 6000 blocks ≈ 10 minutes
WINDOW_BLOCKS=6000
# At startup scan only this many recent blocks (1200 = 2 min). Sweeping needs new mints, and a
# long backfill means thousands of lookups on a busy chain.
BACKFILL_BLOCKS=1200
# A collection is "hot" once this many distinct wallets free-minted in the window...
MIN_UNIQUE_MINTERS=15
# ...across at least this many txs. Anyone paying ETH disqualifies the collection.
MIN_MINT_TXS=20
# Reject contracts that don't report ERC-721/1155 via ERC-165 (blocks fake NFT events)
REQUIRE_ERC165=true

# ── Snipe mode ─────────────────────────────────────────────────────────────
# Collections listed here use the (much lower) ALLOWLIST_* thresholds and skip
# the ERC-165 check. If ALLOWLIST is set, ONLY these collections are minted.
ALLOWLIST=
ALLOWLIST_MIN_UNIQUE_MINTERS=1
ALLOWLIST_MIN_MINT_TXS=1
DENYLIST=

# ── Limits & gas ───────────────────────────────────────────────────────────
MAX_MINTS_PER_COLLECTION=1
# Worst-case gas per tx (ETH). Txs that could cost more are not sent.
MAX_GAS_COST_ETH=0.0005
# Kill switch: total gas the bot may spend across ALL wallets (persisted in state.json)
TOTAL_GAS_BUDGET_ETH=0.05
# maxFeePerGas = baseFee * this + tip (headroom so base-fee spikes don't strand txs)
BASE_FEE_MULTIPLIER=2
PRIORITY_FEE_GWEI=0
MAX_FEE_PER_GAS_GWEI=
RECEIPT_POLL_MS=250
RECEIPT_TIMEOUT_MS=60000

# ── Ops tools ──────────────────────────────────────────────────────────────
# `npm run fund` tops each wallet up to FUND_TARGET_ETH from this key;
# `npm run recover` sends leftovers back to it.
FUNDER_PRIVATE_KEY=
FUND_TARGET_ETH=0.002
# `npm run collect` moves every minted NFT here
VAULT_ADDRESS=

STATE_FILE=state.json

# ── Strategy & safety (what to mint) ───────────────────────────────────────
# true: mint EVERY new collection whose observed mints were all free, after the safety
# checks below. false: only collections that MIN_UNIQUE_MINTERS wallets are minting.
SWEEP_ALL=true
# Only mint collections whose source is verified on the explorer (new contracts are
# often verified minutes late; unverified ones are re-checked, not blacklisted)
REQUIRE_VERIFIED=false
# Trace the mint with debug_traceCall (when the RPC allows it) and refuse mints that
# call approve/setApprovalForAll/transfer, move ETH, or self-destruct
VET_TRACE=true
# Blockscout-compatible API used for the verification check (default: Robinhood Chain's)
EXPLORER_API=

# ── Gas savers ─────────────────────────────────────────────────────────────
# Only this many wallets mint each collection (0 = all). With 30 wallets, 3 cuts cost ~10x.
MAX_WALLETS_PER_COLLECTION=0
# Skip minting while the chain base fee is above this (waits out spikes)
MAX_BASE_FEE_GWEI=0.05
# Tip is 0 by default (Orbit chains order first-come-first-served). Opt in to the node's suggestion:
USE_SUGGESTED_TIP=false

# ── Telegram bot (npm run tg) ──────────────────────────────────────────────
# Create a bot with @BotFather; your numeric id from @userinfobot
TELEGRAM_BOT_TOKEN=
ADMIN_IDS=
# `npm run tg:genkey` — encrypts every user's wallet keys on disk. BACK IT UP.
MASTER_KEY=
DATA_DIR=data
# false = users need an invite (/invite as admin)
OPEN_REGISTRATION=false
MAX_USERS=100
MAX_WALLETS_PER_USER=25
# Users can tune their limits but never above these
CEILING_MAX_GAS_COST_ETH=0.002
CEILING_TOTAL_GAS_BUDGET_ETH=0.5
# Mint attempts in flight across all users (protects the shared RPC)
MAX_CONCURRENT_MINTS=60
ALLOW_EXPORT=true
EXPORT_TTL_SEC=60
STALL_ALERT_SEC=90

# ── Selling / holding advice (npm run plan, /plan in Telegram) ─────────────
# auto  = value every NFT from real sales (wash trades removed) + OpenSea floors + a rarity
#         premium, then decide hold / sell / dead / wait by itself
# tiers = ignore the market and use PLAN_TIERS below
PLAN_MODE=auto
# Optional but recommended: an OpenSea API key gives live floors and owner counts.
# Get one at opensea.io: profile > Settings > Developer > Get access (see README).
OPENSEA_API_KEY=
# Leave empty to look the chain up automatically
OPENSEA_CHAIN=
# Lets accepted offers (paid in WETH) count as sales; the WETH contract address on this chain
WETH_ADDRESS=
# Everything is shown in dollars using a live ETH price (median of Coinbase, Kraken and CoinGecko).
# ETH_USD is only a fallback for when none of them can be reached.
ETH_USD=
# Marketplace fee + creator royalty lost on each sale, in percent
MARKET_FEE_PCT=5
# Hold only the rarest X% of a collection, and only while demand looks healthy
HOLD_TOP_PCT=15
HOLD_MIN_SCORE=65
HOLD_MIN_USD=10
# NFTs worth less than this are not worth listing
MIN_LIST_USD=0.5
# A collection with no sale this long after mint is written off
DEAD_AFTER_HOURS=48
# Only used when PLAN_MODE=tiers. Rarest first: hold:15 = keep the rarest 15%, 25:10 = next 10% at $25
PLAN_TIERS=hold:15,25:10,12.5:25,5:50
RARITY_SAMPLE=1500
METADATA_CONCURRENCY=8
IPFS_GATEWAYS=

# ── Speed ──────────────────────────────────────────────────────────────────
# Poll interval in ms. Blocks come every ~100 ms.
POLL_INTERVAL_MS=100
# One batched request per tick for new blocks + transactions + mint logs
LIVE_FEED=true
# Optional WebSocket endpoint from your RPC provider: new blocks are pushed to the bot instantly.
# The free public RPC has none. Looks like wss://...
RPC_WS_URL=
# With a free simulation proving the mint delivers, every wallet starts at once
FAST_MODE=true

# ── Drops announced ahead of time ──────────────────────────────────────────
# Many drops run through OpenSea's SeaDrop contract, which announces price and start time
# on-chain before the mint opens. With DROPS=true the bot prepares in advance and mints the
# moment a FREE drop opens. Paid drops are never armed.
DROPS=true
# SeaDrop address (default is right for Robinhood Chain)
SEADROP_ADDRESS=
# Only arm drops that start within this many hours
DROP_LEAD_HOURS=24
# Tokens per wallet per drop (capped by the drop's own limit)
DROP_QUANTITY=1
# Gas limit for a drop mint (it cannot be estimated before the drop opens)
DROP_GAS_LIMIT=220000
# How often an armed drop is checked once it is about to open
DROP_POLL_MS=250
MAX_ARMED_DROPS=60

# ── Running on Render (free) with Supabase (free) ──────────────────────────
# Full guide: docs/DEPLOY_RENDER.md. Render wipes its disk on every restart, so the bot mirrors its
# data to Supabase and restores it on start. Leave both empty to keep data only on this machine.
SUPABASE_URL=
# The server-side SECRET key (service_role / sb_secret_...). Never the public anon key.
SUPABASE_SERVICE_KEY=
# Render sets PORT and RENDER_EXTERNAL_URL itself. A listening port makes /health available, which a
# free pinger (cron-job.org / UptimeRobot) calls every 5 minutes so Render does not put the bot to sleep.
PORT=
# Set to true only if you knowingly run on Render WITHOUT Supabase (all wallets are lost on restart).
ALLOW_EPHEMERAL=false

