# ── Network ────────────────────────────────────────────────────────────────
# Robinhood Chain mainnet = 4663, testnet = 46630. Any other id works with RPC_URLS (e.g. a local fork).
CHAIN_ID=4663
# One or more RPC URLs (comma/space separated). Extra URLs are automatic failover,
# ranked by latency. Paid, low-latency RPCs are what win races. Empty = public RPC.
RPC_URLS=
RPC_TIMEOUT_MS=5000

# ── Wallets (all sources are merged and de-duplicated) ─────────────────────
# USE FRESH BURNER WALLETS holding only gas ETH.
# Easiest: `npm run wallets:new -- 25` then KEYS_FILE=wallets.txt
KEYS_FILE=
PRIVATE_KEYS=
# Or derive WALLET_COUNT wallets from one seed phrase (m/44'/60'/0'/0/i)
MNEMONIC=
WALLET_COUNT=20
# How many wallets mint at the same time
WALLET_CONCURRENCY=25

# ── Mode ───────────────────────────────────────────────────────────────────
# Simulates and logs only. Set to false to actually send mint txs.
DRY_RUN=true

# ── Detection ──────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=1000
WINDOW_BLOCKS=1200
# A collection is "hot" once this many distinct wallets free-minted in the window...
MIN_UNIQUE_MINTERS=15
# ...across at least this many txs. Anyone paying ETH disqualifies the collection.
MIN_MINT_TXS=20
# Reject contracts that don't report ERC-721/1155 via ERC-165 (blocks fake NFT events)
REQUIRE_ERC165=true

# ── Snipe mode ─────────────────────────────────────────────────────────────
# Collections listed here use the (much lower) ALLOWLIST_* thresholds and skip
# the ERC-165 check. If ALLOWLIST is set, ONLY these collections are minted.
ALLOWLIST=
ALLOWLIST_MIN_UNIQUE_MINTERS=1
ALLOWLIST_MIN_MINT_TXS=1
DENYLIST=

# ── Limits & gas ───────────────────────────────────────────────────────────
MAX_MINTS_PER_COLLECTION=1
# Worst-case gas per tx (ETH). Txs that could cost more are not sent.
MAX_GAS_COST_ETH=0.0005
# Kill switch: total gas the bot may spend across ALL wallets (persisted in state.json)
TOTAL_GAS_BUDGET_ETH=0.05
# maxFeePerGas = baseFee * this + tip (headroom so base-fee spikes don't strand txs)
BASE_FEE_MULTIPLIER=2
PRIORITY_FEE_GWEI=0
MAX_FEE_PER_GAS_GWEI=
RECEIPT_POLL_MS=250
RECEIPT_TIMEOUT_MS=60000

# ── Ops tools ──────────────────────────────────────────────────────────────
# `npm run fund` tops each wallet up to FUND_TARGET_ETH from this key;
# `npm run recover` sends leftovers back to it.
FUNDER_PRIVATE_KEY=
FUND_TARGET_ETH=0.002
# `npm run collect` moves every minted NFT here
VAULT_ADDRESS=

STATE_FILE=state.json
