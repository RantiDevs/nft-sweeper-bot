{
  "name": "nft-sweeper-bot",
  "version": "0.1.0",
  "description": "Detects trending free NFT mints on Robinhood Chain and mints them",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "wallets:new": "tsx src/cli/new-wallets.ts",
    "balances": "tsx src/cli/balances.ts",
    "fund": "tsx src/cli/fund.ts",
    "recover": "tsx src/cli/recover.ts",
    "collect": "tsx src/cli/collect.ts",
    "tg": "tsx src/tg/index.ts",
    "tg:genkey": "tsx src/tg/genkey.ts",
    "plan": "tsx src/cli/plan.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "inspect": "tsx src/cli/inspect.ts",
    "snipe": "tsx src/cli/snipe.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts && vitest run -c vitest.tg.config.ts",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "dotenv": "^16.4.5",
    "grammy": "^1.46.0",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.26",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
