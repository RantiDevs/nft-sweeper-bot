# Search provider: serper | brave | serpapi
SEARCH_PROVIDER=serper
SERPER_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Search politeness / cost controls
SEARCH_MIN_INTERVAL=1.0        # seconds between search API calls
SEARCH_MAX_RETRIES=4
DAILY_QUERY_BUDGET=100         # max search API calls per UTC day

# Enrichment
USER_AGENT=LeadMinerBot/0.1 (+https://rantidevs.org)
FETCH_TIMEOUT=15
DOMAIN_MIN_INTERVAL=1.0        # seconds between requests to the same domain

# Drafting (optional step)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback; set to 0 if your platform does not support it
ANTHROPIC_FALLBACKS=1
SENDER_NAME=
SENDER_ROLE=

# Storage
LEAD_MINER_DB=lead_miner.db
LEAD_MINER_LOG=lead_miner.log
